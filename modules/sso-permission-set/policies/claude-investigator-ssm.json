{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SSMRunInvestigateDocuments",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": [
        "arn:aws:ssm:*:*:document/claude-investigate-*",
        "arn:aws:ec2:*:*:instance/*"
      ]
    },
    {
      "Sid": "SSMReadInvocations",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:ListCommands",
        "ssm:DescribeInstanceInformation",
        "ssm:GetDocument",
        "ssm:DescribeDocument"
      ],
      "Resource": "*"
    }
  ]
}
